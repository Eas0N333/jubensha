# 反向代理：先让 nginx 用 80 端口把域名接过来，证书随后由 certbot 加上。
#
#   sudo cp deploy/nginx.http.conf.example /etc/nginx/sites-available/online-story
#   sudo vim /etc/nginx/sites-available/online-story      # 把 game.example.com 换成你的域名
#   sudo ln -s /etc/nginx/sites-available/online-story /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d 你的域名                       # 这一步会往本文件里写 443 + 证书 + 301
#
# 为什么第一份配置里不直接写 ssl_certificate：证书还不存在时 nginx -t 会直接失败
# （cannot load certificate），nginx 也就 reload 不了，域名根本接不起来。
# 所以顺序必须是「先 HTTP 通，再让 certbot 补 TLS」。
#
# 已经签过证书之后（比如重跑部署脚本），直接用 deploy/nginx.conf.example。
#
# 关键点只有一个：Socket.IO 的 WebSocket 升级头必须透传，
# 否则语音信令会掉回轮询，游戏状态也会变得很慢。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name game.example.com;

    # 本剧本杀没有大文件上传，8M 足够
    client_max_body_size 8m;

    # 静态资源和接口
    location / {
        proxy_pass         http://127.0.0.1:5178;
        proxy_http_version 1.1;

        # ↓↓↓ 这两行是 WebSocket 升级，不能省 ↓↓↓
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # 语音信令是长连接，别让它被 60 秒超时掐断
        proxy_read_timeout  7d;
        proxy_send_timeout  7d;
        proxy_buffering     off;
    }

    # socket.io 的握手路径单独放一份，规则同上（有些环境需要）
    location /socket.io/ {
        proxy_pass         http://127.0.0.1:5178;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  7d;
        proxy_send_timeout  7d;
        proxy_buffering     off;
    }

    # 线索插画是即时生成的 SVG。缓存头交给 Node 下发（no-cache + ETag），
    # 别在这里写 expires——那样改了插画要等一小时才更新。
    location /api/art/ {
        proxy_pass http://127.0.0.1:5178;
        proxy_set_header Host $host;
    }
}
