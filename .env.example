# 把这份复制成 .env 再改（node --env-file=.env server/index.js）
# 所有变量都是可选的，不设就用默认值。

# 监听端口
PORT=5178

# 绑定地址。云服务器保持 0.0.0.0；只给本机用可以设 127.0.0.1
HOST_BIND=0.0.0.0

# 放在 nginx / 云负载均衡后面时设为 1，让日志拿到真实访客 IP
# TRUST_PROXY=1

# 用 node server/index.js --https 起自签 HTTPS 时设为 1（有域名走 nginx 就别开）
# HTTPS=1

# 通行码：设了之后建房和加入都要带上。公网部署强烈建议设置。
# ACCESS_CODE=换成你自己的口令

# 对外地址，只影响启动时打印的那行，方便自己复制
# PUBLIC_URL=https://game.example.com

# WebRTC 打洞。/api/rtc-config 会把它们下发给浏览器。
# 只用公共 STUN 的话，一部分玩家（严格 NAT / 移动网络）会连不上语音。
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=gameuser
# TURN_PASS=换成coturn里配的密码
